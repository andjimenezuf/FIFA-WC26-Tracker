# Copy to .env (gitignored) in this directory — ADK auto-loads it on
# startup, no `export` needed. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: any OpenRouter model, as "openrouter/<provider>/<model>".
# Defaults to openrouter/openai/gpt-4o-mini if unset.
# LLM_MODEL=openrouter/anthropic/claude-3.5-haiku
